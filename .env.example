# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_PATH=/data/db/db.sqlite3

# Superuser (created on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-in-production

# RCON Configuration (defaults, can be overridden per server)
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=change-me-in-production

# Minecraft Server Paths
MINECRAFT_DATA_PATH=/data

# Server Detection (comma-separated lists)
SERVER_HOSTS=localhost,127.0.0.1
LOCAL_HOSTS=localhost,127.0.0.1
CENTRAL_PANEL_HOST=

# Email Configuration (optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_FROM_EMAIL=noreply@example.com
EMAIL_FROM_NAME=Minecraft Server Manager

# Webhook URL (optional)
WEBHOOK_URL=

# Docker Registry (for building/pushing images)
DOCKER_REGISTRY=registry.example.com
DOCKER_NAMESPACE=your-namespace
