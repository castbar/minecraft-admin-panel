# Configuración del Servidor Minecraft
# Copia este archivo a .env.minecraft y personaliza los valores

# Información del contenedor
CONTAINER_NAME=minecraft-server-1

# Puertos
GAME_PORT=25565
RCON_PORT=25575

# Tipo y versión del servidor
SERVER_TYPE=VANILLA
MC_VERSION=1.21.1

# Recursos
MEMORY=2G

# RCON (para control remoto desde el panel)
RCON_PASSWORD=password123

# Configuración del juego
DIFFICULTY=normal
MAX_PLAYERS=20
ONLINE_MODE=false
PVP=true
WHITELIST=false

# Mensajes
MOTD=Servidor de Prueba - Minecraft Admin Panel
SERVER_NAME=Servidor de Prueba

